[
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "tests",
    "command": [
      "cargo",
      "test",
      "--locked",
      "--workspace"
    ],
    "exit": 0
  },
  {
    "name": "doc",
    "command": [
      "cargo",
      "doc",
      "--locked",
      "--workspace",
      "--no-deps"
    ],
    "exit": 0
  },
  {
    "name": "size",
    "command": [
      "python3",
      "scripts/check-rust-size.py"
    ],
    "exit": 0
  },
  {
    "name": "links",
    "command": [
      "python3",
      "scripts/check-doc-links.py"
    ],
    "exit": 0
  },
  {
    "name": "strings",
    "command": [
      "python3",
      "scripts/check-ui-strings.py"
    ],
    "exit": 0
  },
  {
    "name": "layers",
    "command": [
      "python3",
      "scripts/check-layers.py"
    ],
    "exit": 0
  },
  {
    "name": "deny",
    "command": [
      "cargo",
      "deny",
      "--locked",
      "check",
      "licenses",
      "bans",
      "sources"
    ],
    "exit": 0
  },
  {
    "name": "build",
    "command": [
      "cargo",
      "build",
      "--locked",
      "-p",
      "scholium-app",
      "-p",
      "scholium-storage",
      "--bins"
    ],
    "exit": 0
  }
]
