+function M.box(st, n, x, y, w, h, d)
+  local tag = owner(n, M.attr)
+  local role = roles[node.direct.getsubtype(n)]
+  if not tag or not role then return end
+  local boxes = state(st).boxes
+  boxes[#boxes + 1] = { owner = tag, role = role, bbox = { x, y - h, x + w, y + d },
+    empty = node.direct.getlist(n) == nil }
+end
+function M.boundary(st, n, x, y, h, d)
+  local tag = owner(n, M.attr)
+  local formula = owner(n, M.formula_attr)
+  if not tag and not formula then return end
+  local boundaries = state(st).boundaries
+  boundaries[#boundaries + 1] = { owner = tag, formula = formula,
+    on = node.direct.getsubtype(n) == 0, bbox = { x, y - h, x, y + d } }
+end
+-- Empty packed fields get the attribute state at conversion time (after the
+-- formula reset), so their own attributes are not reliable. Add a zero-size
+-- marker only to a truly empty sub_mlist, never before a nonempty character.
+local marker_id = 220650
+local role_codes = { num = 1, den = 2, radicand = 3, sup = 4, sub = 5, degree = 6 }
+local code_roles = { 'num', 'den', 'radicand', 'sup', 'sub', 'degree' }
+local function mark_fields(head)
+  if not head then return end
+  for n in node.traverse(head) do
+    local kind = node.type(n.id)
+    local tag = node.has_attribute(n, M.attr)
+    local fields = {}
+    if kind == 'noad' then fields = { nucleus = false, sup = 'sup', sub = 'sub' }
+    elseif kind == 'fraction' then fields = { num = 'num', denom = 'den' }
+    elseif kind == 'radical' then fields = { nucleus = 'radicand', degree = 'degree', sup = 'sup', sub = 'sub' }
+    elseif kind == 'sub_mlist' then mark_fields(n.head) end
+    for field, role in pairs(fields) do
+      local child = n[field]
+      if child and node.type(child.id) == 'sub_mlist' then
+        if not child.head and role and tag and tag > 0 then
+          local marker = node.new('whatsit', 'user_defined')
+          marker.user_id, marker.type, marker.value = marker_id, 100, role_codes[role]
+          node.set_attribute(marker, M.attr, tag)
+          child.head = marker
+        else mark_fields(child.head) end
+      end
     end
-    source = desc.parent
   end
+  return head
+end
+luatexbase.add_to_callback('pre_mlist_to_hlist_filter', mark_fields, 'scholium-empty-fields')
+function M.marker(st, n, x, y, h, d)
+  if node.direct.getsubtype(n) ~= node.subtype('user_defined') or
+     node.direct.getfield(n, 'user_id') ~= marker_id then return false end
+  local tag = owner(n, M.attr)
+  local role = code_roles[node.direct.getfield(n, 'value')]
+  local boxes = state(st).boxes
+  boxes[#boxes + 1] = { owner = tag, role = role, bbox = { x, y - h, x, y + d }, empty = true }
+  return true
 end
 return M
