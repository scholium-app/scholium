diff --git a/tex/rtex-math-edit.lua b/tex/rtex-math-edit.lua
new file mode 100644
index 0000000..724800e
--- /dev/null
+++ b/tex/rtex-math-edit.lua
@@ -0,0 +1,58 @@
+-- Evaluation-only source ownership. Attribute 65000 is reserved by the host fixture.
+-- No nodes, dimensions, or math classes are changed by this observer.
+local M = { attr = 65000, noads = {} }
+local getattribute = node.direct.getattribute or node.direct.get_attribute
+local fields = { 'nucleus', 'sub', 'sup', 'num', 'denom', 'degree', 'head' }
+local function walk(head, parent, role, depth)
+  if not head or depth > 48 then return end
+  for n in node.traverse(head) do
+    local source = node.has_attribute(n, M.attr)
+    local key = tostring(n)
+    if source and scholium_math_sources and scholium_math_sources[source] then
+      if not M.seen[source] then M.noads[source] = {}; M.seen[source] = true end
+      local out = M.noads[source]
+      out[#out + 1] = { kind = node.type(n.id), subtype = n.subtype,
+                       parent = parent, role = role, key = key }
+    end
+    for _, field in ipairs(fields) do
+      local ok, child = pcall(function() return n[field] end)
+      if ok and type(child) == 'userdata' then walk(child, key, field, depth + 1) end
+    end
+  end
+end
+luatexbase.add_to_callback('pre_mlist_to_hlist_filter', function(head)
+  -- Keep other formulas, replacing repeated observations for IDs in this conversion.
+  M.seen = {}
+  walk(head, '', 'formula', 0)
+  return head
+end, 'scholium-math-observer')
+
+function M.glyph(st, n, x, y, w)
+  local source = getattribute(n, M.attr)
+  local sources = scholium_math_sources
+  if not source or not sources or not sources[source] then return end
+  st.math_edit = st.math_edit or { glyphs = {}, nodes = {} }
+  local _, h, d = node.direct.getwhd(n)
+  h, d = h or 0, d or 0
+  local bbox = { x, y - h, x + w, y + d }
+  local glyphs = st.math_edit.glyphs
+  glyphs[#glyphs + 1] = { source_id = source, bbox = bbox,
+    font = node.direct.getfont(n), char = node.direct.getchar(n) }
+  while source and sources[source] do
+    local desc = sources[source]
+    local key = tostring(source)
+    local out = st.math_edit.nodes[key]
+    if not out then
+      out = { id = source, parent = desc.parent, kind = desc.kind,
+              src_range = { desc.start, desc.stop }, bbox = {table.unpack(bbox)},
+              noads = M.noads[source] or {} }
+      st.math_edit.nodes[key] = out
+    else
+      local b = out.bbox
+      b[1], b[2] = math.min(b[1], bbox[1]), math.min(b[2], bbox[2])
+      b[3], b[4] = math.max(b[3], bbox[3]), math.max(b[4], bbox[4])
+    end
+    source = desc.parent
+  end
+end
+return M
